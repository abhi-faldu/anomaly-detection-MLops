# Copy to .env and adjust as needed.

# --- Data ---
DATA_PATH=data/ai4i2020.csv

# --- MLflow ---
# Local SQLite tracking backend + local artifact store (v1 default).
# Upgrade path: point this at a remote tracking server (postgres + minio/s3).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ai4i-predictive-maintenance
MLFLOW_REGISTERED_MODEL_NAME=ai4i-failure-classifier

# --- Training ---
RANDOM_SEED=42
TEST_SIZE=0.2
# PR-AUC floor the CI train-gate enforces (XGBoost baseline ~0.83, margin below).
PR_AUC_FLOOR=0.75

# --- Serving ---
# Registry stage the API loads at startup (None|Staging|Production).
MODEL_STAGE=Production
API_HOST=0.0.0.0
API_PORT=8000
